
FROM node:20-alpine

WORKDIR /app

# Dependencias do sistema
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    ffmpeg \
    git \
    python3 \
    make \
    g++

# Configuracao do Puppeteer
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Instalar dependencias do backend
COPY backend/package*.json ./

RUN npm install

# Copiar codigo do backend
COPY backend/ .

# Compilar TypeScript
RUN npm run build

# Copiar script de inicializacao
COPY docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh

# Normalizar quebras de linha Windows e permissões
RUN sed -i '1s/^\xEF\xBB\xBF//' /usr/local/bin/backend-entrypoint.sh \
    && sed -i 's/\r$//' /usr/local/bin/backend-entrypoint.sh \
    && chmod +x /usr/local/bin/backend-entrypoint.sh

EXPOSE 8080

# Executar explicitamente com shell
ENTRYPOINT ["/bin/sh", "/usr/local/bin/backend-entrypoint.sh"]
